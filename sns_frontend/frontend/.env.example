# Public API origin. Use the deployed HTTPS backend URL, never localhost in production.
VITE_API_BASE_URL=https://api.example.com

# Public URL of the backend's real, authenticated AdminJS panel.
VITE_ADMIN_PANEL_URL=https://api.example.com/admin

# Socket.IO endpoint. Leave empty to derive it from VITE_API_BASE_URL.
VITE_SOCKET_URL=
