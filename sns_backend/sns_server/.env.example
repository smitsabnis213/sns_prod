NODE_ENV=development
HOST=0.0.0.0
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/buddyyaa

# Use independently generated random values (at least 32 characters) outside local development.
ACCESS_TOKEN_SECRET=replace-with-a-random-access-secret-at-least-32-characters
REFRESH_TOKEN_SECRET=replace-with-a-different-refresh-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# AdminJS uses an authenticated Mongo-backed session store.
ADMIN_SESSION_SECRET=replace-with-a-random-admin-session-secret-at-least-32-characters
# Comma-separated exact browser origins; include local development and the deployed HTTPS website.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Phone-only customer authentication is an insecure development convenience. Never enable in production.
CUSTOMER_DEV_LOGIN=false

# Set only for the one-time scripts/create-admin.js command.
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
